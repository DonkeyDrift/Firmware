{
  "permissions": {
    "allow": [
      "Bash(git branch:*)",
      "Bash(python:*)",
      "Bash(gh pr:*)",
      "Bash(~/.arduino15/packages/esp32/tools/xtensa-esp32-elf-gcc/esp-12.2.0_20230208/bin/xtensa-esp32-elf-g++:*)",
      "Skill(update-config)",
      "PowerShell(.\\arduino-cli-wsl.ps1 -Upload -HttpOta -HttpOtaHost *)",
      "PowerShell(.\\arduino-cli-wsl.ps1 -Compile -Upload -HttpOta -HttpOtaHost *)",
      "PowerShell(.\\arduino-cli-wsl.ps1 -c -u -HttpOta -HttpOtaHost *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$payload = [Console]::In.ReadToEnd() | ConvertFrom-Json; $cmd = [string]$payload.tool_input.command; if ($cmd -match 'arduino-cli-wsl\\.ps1' -and (($cmd -match '(^|\\s)-Compile(\\s|$)') -or ($cmd -match '(^|\\s)-c(\\s|$)')) -and ($cmd -notmatch '(^|\\s)-(Upload|u)(\\s|$)') -and ($cmd -match 'MUS4_FW\\.ino')) { if ($env:MUS4_HOOK_DRY_RUN -eq '1') { Write-Output 'would-http-ota 192.168.3.52'; exit 0 }; & '.\\arduino-cli-wsl.ps1' -Upload -HttpOta -HttpOtaHost '192.168.3.52' -Sketch 'MUS4_FW.ino' }",
            "timeout": 180,
            "statusMessage": "编译成功后自动 HTTP OTA 到 192.168.3.52"
          }
        ]
      }
    ]
  }
}
